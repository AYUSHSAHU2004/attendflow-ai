# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM (any OpenAI-compatible endpoint) ---
# Groq (default):   https://api.groq.com/openai/v1
# Together:         https://api.together.xyz/v1
# Ollama (local):   http://localhost:11434/v1   (any non-empty API key works)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Hosted Docker on Render: add a runtime Secret File and set this to its path instead.
# LLM_API_KEY_FILE=/etc/secrets/groq-api-key
LLM_TIMEOUT_SECONDS=30
# Use off to omit reasoning effort for providers or models that do not support it.
LLM_REASONING_EFFORT=low
AGENT_MAX_STEPS=5
LLM_INVESTIGATION_BUDGET_SECONDS=45

# --- Demo clock ---
# "Now" for the rule engine. Plain local time, no timezone offset.
# Punches after this moment are ignored; schedule rows after it are treated as forecast.
ATTENDFLOW_AS_OF=2026-04-16T08:00:00

# Optional: override the data folder (defaults to ./data)
# ATTENDFLOW_DATA_DIR=

# --- Database (docker compose up -d db) ---
DATABASE_URL=postgresql+psycopg://attendflow:attendflow@localhost:5433/attendflow
# Used by pytest. API tests are skipped if it is unreachable, unless REQUIRE_DB=1 (CI).
TEST_DATABASE_URL=postgresql+psycopg://attendflow:attendflow@localhost:5433/attendflow_test

# --- API ---
# POST /api/seed wipes every table and reloads the demo CSVs. Must be false (or protected)
# on any deployed server (Phase 22).
ATTENDFLOW_ENABLE_SEED=true
# json (one JSON object per line) or text (readable, for local development)
LOG_FORMAT=json
LOG_LEVEL=INFO
# Browser origins allowed to call the API (comma-separated). Default: the Vite dev server.
# ATTENDFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo-only rejected extraction previews. Set off in real deployments.
LLM_DIAGNOSTICS=on

# --- Mock attendance device (POST /api/punches) ---
# Devices send this key in the X-Device-Key header. Unset = the endpoint answers 503.
# Use a long random value; never commit the real one.
DEVICE_API_KEY=
# Punches older than this many days before the as-of time are refused.
DEVICE_MAX_BACKDATE_DAYS=7

# --- Runtime settings (Phase 18) ---
# The values below are the server's starting values. The payroll admin can override ten
# of them while the app runs (PUT /api/settings/{key}, audited, no restart), within these
# bounds: AUTO_RESOLVE_ENABLED (turning on needs confirm), NO_REPLY_REMINDER_HOURS 1-72,
# NO_REPLY_SUPERVISOR_HOURS 2-168, NO_REPLY_ADMIN_HOURS 1-168,
# SCHEDULER_INVESTIGATIONS_PER_CYCLE 0-5, SCHEDULER_MESSAGES_PER_CYCLE 0-10,
# BRIEFING_MIN_INTERVAL_SECONDS 60-3600, BRIEFING_MAX_LLM_CALLS_PER_DAY 0-100,
# BRIEFING_SCHEDULED, QA_QUESTIONS_PER_HOUR 1-30, QA_MAX_LLM_CALLS_PER_DAY 0-100,
# OVERTIME_WARNING_MARGIN_HOURS 0.5-20 (steps of 0.5).
# Overrides live in the database (settings row runtime_overrides) and a demo reset clears
# them. Everything else here (LLM, secrets, database, demo mode, as-of, diagnostics,
# policy.json) can never be changed at runtime. The deployed Locked profile
# (ATTENDFLOW_DEPLOYED=true, ATTENDFLOW_DEMO_MODE=false) refuses every change.

# --- Scheduler (detect, investigate new cases, message workers) ---
# Off by default. The cycle never runs the LLM itself; it reuses the investigate and
# ask-worker steps with their template fallbacks. Keep the limits low on the Groq free tier.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_INVESTIGATIONS_PER_CYCLE=3
SCHEDULER_MESSAGES_PER_CYCLE=3
# false: only cases first detected after the scheduler started (or a demo reset).
SCHEDULER_BACKLOG=false

# --- Auto-resolve (Phase 12) ---
# Kill switch. true: P2 duplicate taps and P7 late arrivals within grace close without a
# person when the engine's numbers prove it (anything unclear stays with people). false:
# nothing auto-resolves; those cases are stored open for a person. Which policies may
# auto-resolve is set in data/policy.json ("auto_resolve"); only P2 and P7 are allowed.
AUTO_RESOLVE_ENABLED=true

# --- No-reply ladder (Phase 13) ---
# A case waiting for a worker: one reminder after REMINDER hours, then the team supervisor
# after SUPERVISOR hours (both counted from the question, or from a No that still needs
# the time), then the payroll admin ADMIN hours after the supervisor was brought in.
# Checked in every scheduler cycle (or "Run scheduler now"). Silence is never a Yes and
# never changes a timecard. REMINDER must be less than SUPERVISOR. Review before deploy.
NO_REPLY_ESCALATION_ENABLED=true
NO_REPLY_REMINDER_HOURS=8
NO_REPLY_SUPERVISOR_HOURS=24
NO_REPLY_ADMIN_HOURS=24

# --- Operations dashboard (Phase 15) ---
# Show forecasts this many hours below the P5 weekly limit. Must be positive.
OVERTIME_WARNING_MARGIN_HOURS=4

# --- Daily briefing (Phase 17) ---
# The LLM phrases a code-built facts packet; code checks every number, case ID, name and
# claim. One correction request if a draft fails a check; provider errors and timeouts go
# straight to the template. Reading a briefing never calls the LLM.
BRIEFING_ENABLED=true
# The scheduler writes Priya's briefing at most once per workflow day, only after new
# activity since the scheduler watermark and when the facts changed.
BRIEFING_SCHEDULED=true
# Real seconds between two briefings for the same scope (the demo clock can jump).
BRIEFING_MIN_INTERVAL_SECONDS=300
# All briefing LLM calls per real UTC day, all scopes together (a correction counts too).
BRIEFING_MAX_LLM_CALLS_PER_DAY=40
# Wall-clock budget for one generation (both calls together).
BRIEFING_LLM_DEADLINE_SECONDS=20

# --- Employee Q&A (Phase 20) ---
# Workers ask short questions about their own leave, schedule, punches, cases and the
# policy. Code picks the facts (the asker comes from the request, never the question) and
# checks every number, date, ID and name in the answer; else a template answer. Off = only
# template answers (no LLM call). At most 3 calls per question: an intent pick only when the
# keywords find nothing, the answer, and one correction after a failed check. A provider
# error, a rate limit (HTTP 429) or the deadline goes straight to the template.
QA_ENABLED=true
QA_MAX_QUESTION_CHARS=300
# Questions per worker per rolling real hour (429 qa_rate_limited above it).
QA_QUESTIONS_PER_HOUR=10
# All Q&A LLM calls per real UTC day, all workers together. Above it: template answers.
QA_MAX_LLM_CALLS_PER_DAY=60
# Wall-clock budget for one question (all its calls together).
QA_LLM_DEADLINE_SECONDS=15

# --- Demo mode ---
# Adds /api/admin/demo/punch and /api/admin/demo/clock, plus their admin controls.
# Reset also requires ATTENDFLOW_DEMO_RESET_ENABLED. Keep demo mode off for
# Phase 22. With it off the clock stays at ATTENDFLOW_AS_OF.
ATTENDFLOW_DEMO_MODE=false
# Local demo mode allows reset unless this is explicitly disabled.
# Deployed mode defaults this to false independently of ATTENDFLOW_DEMO_MODE.
ATTENDFLOW_DEMO_RESET_ENABLED=true
# Seed and demo reset can add a clean closed week (6–12 Apr) for sign-off practice.
# Keep off in deployment (Phase 22).
ATTENDFLOW_DEMO_EXTRA_WEEK=false

# --- Authentication ---
# Header mode preserves the local demo personas. For real login, use session.
ATTENDFLOW_AUTH_MODE=header
# Set to an independent random value of at least 32 bytes for session or deployed mode.
ATTENDFLOW_SESSION_SECRET=
# Keep false for local HTTP. Set true when the public URL uses HTTPS.
ATTENDFLOW_COOKIE_SECURE=false
# Set true only when the app is reachable solely through the trusted Traefik hop.
ATTENDFLOW_TRUSTED_PROXY=false
# Set to a strong random value to provision synthetic accounts. Keep out of source control.
ATTENDFLOW_DEMO_PASSWORD=

# --- Hosted demo profiles (set these on the host, separate from local .env) ---
# Common: ATTENDFLOW_DEPLOYED=true, LLM_DIAGNOSTICS=off, ATTENDFLOW_CORS_ORIGINS empty.
# Set ATTENDFLOW_AUTH_MODE=session and ATTENDFLOW_COOKIE_SECURE=true on the host.
# Set DATABASE_URL, ATTENDFLOW_SESSION_SECRET and ATTENDFLOW_DEMO_PASSWORD as runtime secrets.
# Run one API worker with SCHEDULER_ENABLED=true and SCHEDULER_BACKLOG=false.
#
# Locked profile (first deploy and smoke check):
# ATTENDFLOW_ENABLE_SEED=false
# ATTENDFLOW_DEMO_MODE=false
# ATTENDFLOW_DEMO_RESET_ENABLED=false
# ATTENDFLOW_DEMO_EXTRA_WEEK=false
# DEVICE_API_KEY=
#
# Guided demo profile (synthetic data and login shortcuts):
# ATTENDFLOW_ENABLE_SEED=false
# ATTENDFLOW_DEMO_MODE=true
# ATTENDFLOW_DEMO_RESET_ENABLED=true
# ATTENDFLOW_DEMO_EXTRA_WEEK=true
# DEVICE_API_KEY=
